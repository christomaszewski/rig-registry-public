{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "suite manifest",
  "type": "object",
  "required": [
    "kind",
    "name",
    "version",
    "members"
  ],
  "properties": {
    "kind": {
      "const": "suite"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": {
      "type": "string"
    },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/(?:[a-z][a-z0-9-]*:)?[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/(?:[a-z][a-z0-9-]*:)?[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*/(?:[a-z][a-z0-9-]*:)?[a-z][a-z0-9-]*@\\d+\\.\\d+\\.\\d+$"
          }
        }
      }
    }
  }
}
