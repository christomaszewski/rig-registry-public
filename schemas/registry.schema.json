{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "registry.yaml",
  "type": "object",
  "required": [
    "schema",
    "name",
    "namespace"
  ],
  "properties": {
    "schema": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string"
    }
  }
}
