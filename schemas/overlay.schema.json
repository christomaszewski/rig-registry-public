{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "overlay manifest",
  "type": "object",
  "required": [
    "kind",
    "name",
    "version",
    "targets",
    "config"
  ],
  "properties": {
    "kind": {
      "const": "overlay"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "properties": {
          "service": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "project": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "required": [
        "payload"
      ],
      "properties": {
        "payload": {
          "type": "string"
        }
      }
    }
  }
}
